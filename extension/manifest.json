{
	"manifest_version": 3,
	"name": "Zotero für Claude",
	"version": "0.1.1",
	"description": "Durchsuche deine Zotero-Bibliothek direkt auf claude.ai und füge Zitate, Abstracts, Notizen und PDF-Volltext in den Chat ein.",
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"http://127.0.0.1/*",
		"http://localhost/*",
		"https://api.zotero.org/*",
		"https://claude.ai/*",
		"https://*.claude.ai/*"
	],
	"background": {
		"service_worker": "background/service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"https://claude.ai/*",
				"https://*.claude.ai/*"
			],
			"js": [
				"content/sidebar.js"
			],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "Zotero für Claude",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"options_page": "options/options.html",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"content/sidebar.css"
			],
			"matches": [
				"https://claude.ai/*",
				"https://*.claude.ai/*"
			]
		}
	]
}
